---
import Layout from '../layouts/Layout.astro';
import Expertise from '../components/Expertise.vue';
import ContactForm from '../components/ContactForm.vue';
import soRHLogo from '../assets/soRH.png';
import logoAumex from '../assets/logo-aumex.png';
import background_section1 from '../assets/background_section1.jpg';
import background_section2 from '../assets/background_section2.jpg';
import background_section3 from '../assets/background_section3.jpeg';
import silae_logo from '../assets/silae_logo.png'
import carte_SoRH from '../assets/carte_soRh.png'
---

<Layout title="SO-RH EXPERT | Paie & Conseil RH Premium">

    <!-- NAVIGATION -->
    <nav class="fixed top-0 w-full z-50 bg-white/85 backdrop-blur-md border-b border-[#004732]/10 px-4 md:px-6 py-3 md:py-4 flex justify-between items-center transition-all duration-300">
        <div class="flex items-center gap-2">
            <a href="#home" class="block overflow-visible">
                <img
                        src={soRHLogo.src}
                        alt="so-rh expert"
                        title="so-rh expert"
                        class="h-20 md:h-28 w-auto object-contain scale-150 md:scale-[1.8] origin-left ml-2 md:ml-4 transition-transform duration-300 hover:scale-[1.55] md:hover:scale-[1.85]"
                />
            </a>
        </div>

        <div class="hidden md:flex gap-8 text-xs font-bold uppercase tracking-widest text-[#004732]">
            <a href="#positionnement" class="hover:text-[#00a86b] transition py-2">Notre Vision</a>
            <a href="#expertise" class="hover:text-[#00a86b] transition py-2">Services</a>
            <a href="#silae" class="hover:text-[#00a86b] transition py-2">Silae</a>
            <a href="#why" class="hover:text-[#00a86b] transition py-2">Notre Différence</a>
            <a href="#international" class="hover:text-[#00a86b] transition py-2">International</a>
            <a href="#contact" class="bg-[#004732] text-white px-6 py-2.5 rounded-full hover:bg-[#FFBD59] transition shadow-md">
                Prendre rendez-vous
            </a>
        </div>

        <!-- Menu Mobile Icon -->
        <button id="mobile-menu-toggle" aria-label="Ouvrir le menu" class="md:hidden text-[#004732] p-2 -mr-2 w-11 h-11 flex items-center justify-center relative z-10">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
            </svg>
        </button>

        <!-- Menu Mobile déroulant -->
        <div id="mobile-menu" class="md:hidden absolute top-full left-0 right-0 bg-white/95 backdrop-blur-md border-b border-[#004732]/10 shadow-lg hidden flex-col py-4 px-6 gap-1 text-[#004732] font-bold uppercase tracking-widest text-sm">
            <a href="#positionnement" class="block py-3 border-b border-slate-100 hover:text-[#00a86b] transition">Notre Vision</a>
            <a href="#expertise" class="block py-3 border-b border-slate-100 hover:text-[#00a86b] transition">Services</a>
            <a href="#silae" class="block py-3 border-b border-slate-100 hover:text-[#00a86b] transition">Silae</a>
            <a href="#why" class="block py-3 border-b border-slate-100 hover:text-[#00a86b] transition">Notre Différence</a>
            <a href="#international" class="block py-3 border-b border-slate-100 hover:text-[#00a86b] transition">International</a>
            <a href="#contact" class="block py-3 text-center bg-[#004732] text-white rounded-full mt-2 hover:bg-[#FFBD59] transition">Prendre rendez-vous</a>
        </div>
    </nav>
    <script>
        const toggle = document.getElementById('mobile-menu-toggle');
        const menu = document.getElementById('mobile-menu');
        toggle?.addEventListener('click', () => {
            menu?.classList.toggle('hidden');
            menu?.classList.toggle('flex');
        });
        document.querySelectorAll('nav a[href^="#"]').forEach((link) => {
            link.addEventListener('click', () => {
                window.dispatchEvent(new CustomEvent('close-expertise-modal'));
            });
        });

        menu?.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => {
                menu?.classList.add('hidden');
                menu?.classList.remove('flex');
            });
        });
    </script>

    <!-- MAIN CONTAINER : défilement vertical libre et fluide -->
    <main class="flex flex-col overflow-x-hidden bg-white">

        <!-- SECTION 1 : HERO -->
        <section id="home" class="relative w-full flex flex-col justify-center items-center text-center px-4 pt-32 pb-0 min-h-[100svh] bg-cover bg-center bg-no-repeat bg-fixed"
                 style={`background-image: url('${background_section1.src}');`}
        >
            <!-- 1. Un seul filtre global propre (50% de blanc + léger flou) pour voir l'image sans bloquer la lecture -->
            <div class="absolute inset-0 bg-white/70 backdrop-blur-[2px] z-0"></div>

            <div class="relative z-10 max-w-5xl mx-auto w-full">
                <h1 data-reveal class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6 md:mb-8 leading-tight text-[#004732] tracking-tight drop-shadow-sm">
                    Externalisation de la paie & conseil RH <br class="hidden lg:block"/>
                    <span class="text-[#00a86b] font-light italic">pour entreprises exigeantes.</span>
                </h1>

                <p data-reveal class="text-lg md:text-xl text-slate-800 mb-10 md:mb-12 leading-relaxed max-w-3xl mx-auto font-medium px-2 drop-shadow-sm">
                    <strong class="text-[#004732] font-bold">SO-RH EXPERT</strong> accompagne dirigeants, PME/TPE et structures en croissance dans une gestion sociale fiable, confidentielle et parfaitement maîtrisée.
                </p>

                <!-- 3. Boutons avec un bel effet d'élévation au survol -->
                <div data-reveal class="flex flex-col md:flex-row justify-center items-center gap-4 w-full md:w-auto px-4 md:px-0">
                    <a href="#contact" class="bg-[#004732] text-white text-base md:text-lg px-8 py-4 rounded-full font-bold hover:bg-[#00a86b] hover:-translate-y-1 transition-all duration-300 shadow-xl w-full md:w-auto text-center">
                        Demander un accompagnement
                    </a>
                    <a href="#positionnement" class="text-[#004732] bg-white/10 border border-[#004732]/20 text-base md:text-lg px-8 py-4 rounded-full font-bold hover:bg-white hover:border-[#FFBD59] hover:-translate-y-1 transition-all duration-300 shadow-xl w-full md:w-auto text-center">
                        Découvrir notre expertise
                    </a>
                </div>
            </div>
        </section>

        <!-- SECTION 2 : POSITIONNEMENT -->
        <section id="positionnement" class="
            bg-center bg-cover bg-no-repeat bg-fixed relative scroll-mt-20
            w-full block py-24 px-4"
                 style={`background-image: url('${background_section2.src}');`}
        >
            <div class="absolute inset-0 bg-white/75 backdrop-blur-[2px] z-0"></div>

            <div class="max-w-4xl mx-auto text-center relative z-10 w-full bg-white/60 md:bg-transparent backdrop-blur-md md:backdrop-blur-none rounded-2xl md:rounded-none p-6 md:p-0">
                <span class="text-[#00a86b] font-bold tracking-widest uppercase text-xs md:text-sm mb-3 md:mb-4 block">Notre Vision</span>
                <h2 data-reveal class="text-2xl md:text-5xl font-bold mb-6 md:mb-8 text-[#004732] leading-tight">Une expertise au service <br/>de votre sérénité.</h2>

                <p data-reveal class="text-base md:text-lg text-slate-800 leading-relaxed mb-10 md:mb-12 font-medium">
                    La gestion de la paie et des obligations sociales exige rigueur, précision et parfaite maîtrise du cadre légal. <strong class="text-[#004732] font-bold">SO-RH EXPERT</strong> vous apporte une solution complète, sécurisée et sur mesure.
                </p>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-8 text-left">
                    <div data-reveal class="p-5 md:p-6 bg-white rounded-2xl shadow-md border border-slate-100">
                        <div class="text-[#00a86b] text-xl md:text-2xl mb-3 font-bold">✓</div>
                        <h3 class="font-bold text-[#004732] mb-1 md:mb-2 text-base md:text-lg">Accompagnement Pro</h3>
                        <p class="text-xs md:text-sm text-slate-700 leading-relaxed">Un suivi dédié et professionnel à chaque étape.</p>
                    </div>

                    <div data-reveal class="p-5 md:p-6 bg-white rounded-2xl shadow-md border border-slate-100">
                        <div class="text-[#FFBD59] text-xl md:text-2xl mb-3 font-bold">✓</div>
                        <h3 class="font-bold text-[#004732] mb-1 md:mb-2 text-base md:text-lg">Conformité Garantie</h3>
                        <p class="text-xs md:text-sm text-slate-700 leading-relaxed">Zéro risque légal, votre entreprise est sécurisée.</p>
                    </div>

                    <div data-reveal class="p-5 md:p-6 bg-white rounded-2xl shadow-md border border-slate-100">
                        <div class="text-[#00a86b] text-xl md:text-2xl mb-3 font-bold">✓</div>
                        <h3 class="font-bold text-[#004732] mb-1 md:mb-2 text-base md:text-lg">Gain de Temps</h3>
                        <p class="text-xs md:text-sm text-slate-700 leading-relaxed">Libérez-vous des contraintes pour piloter votre croissance.</p>
                    </div>
                </div>

                <!-- Points discrets issus du bandeau supprimé -->
                <div class="mt-8 md:mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs md:text-sm text-[#004732]/70 font-medium">
                    <span class="flex items-center gap-1.5"><span class="text-[#00a86b]">✓</span> Accompagnement 100% sur-mesure</span>
                    <span class="flex items-center gap-1.5"><span class="text-[#00a86b]">✓</span> Conformité légale garantie</span>
                    <span class="flex items-center gap-1.5"><span class="text-[#00a86b]">✓</span> Zéro retard de paie</span>
                </div>
            </div>
        </section>

        <!-- SECTION 3 : EXPERTISE SILAE -->
        <section id="silae" class="w-full bg-white block py-20 md:py-24 px-4 scroll-mt-20">
            <div class="max-w-5xl mx-auto text-center">
                <span class="text-[#00a86b] font-bold tracking-widest uppercase text-xs md:text-sm mb-3 block">Expertise Silae</span>
                <h2 data-reveal class="text-2xl md:text-4xl font-bold mb-4 md:mb-6 text-[#004732] leading-tight">Une maîtrise complète <br class="hidden md:block"/>du logiciel <span class="italic font-light">Silae</span>.</h2>
                <p data-reveal class="text-base md:text-lg text-slate-700 leading-relaxed mb-10 md:mb-12 font-medium max-w-3xl mx-auto">
                    SO-RH EXPERT s'appuie sur <strong class="text-[#004732] font-bold">Silae</strong>, l'un des logiciels de paie les plus avancés du marché, pour garantir une production fiable, sécurisée et rigoureuse.
                </p>

                <!-- Placeholder pour le logo Silae -->
                <div data-reveal class="flex justify-center mb-10 md:mb-12">
                    <div class="w-48 h-24 md:w-64 md:h-32 rounded-2xl border-2 border-dashed border-[#00a86b]/30 bg-[#f8faf9] flex items-center justify-center">
                        <img src={silae_logo.src} alt="Logo Silae" class="max-w-full max-h-full object-contain p-3" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 max-w-4xl mx-auto text-left">
                    <div data-reveal class="p-6 bg-[#f8faf9] rounded-2xl shadow-md border border-slate-100">
                        <div class="w-12 h-12 rounded-full bg-[#004732] text-white flex items-center justify-center mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="font-bold text-[#004732] mb-2 text-base md:text-lg">Sécurité et Contrôle</h3>
                        <p class="text-xs md:text-sm text-slate-700 leading-relaxed">Une vérification humaine systématique complète la performance technique du logiciel.</p>
                    </div>

                    <div data-reveal class="p-6 bg-[#f8faf9] rounded-2xl shadow-md border border-slate-100">
                        <div class="w-12 h-12 rounded-full bg-[#00a86b] text-white flex items-center justify-center mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                        </div>
                        <h3 class="font-bold text-[#004732] mb-2 text-base md:text-lg">Outil de Pointe</h3>
                        <p class="text-xs md:text-sm text-slate-700 leading-relaxed">Un logiciel moderne et performant pour une paie précise et sécurisée.</p>
                    </div>

                    <div data-reveal class="p-6 bg-[#f8faf9] rounded-2xl shadow-md border border-slate-100">
                        <div class="w-12 h-12 rounded-full bg-[#FFBD59] text-white flex items-center justify-center mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="font-bold text-[#004732] mb-2 text-base md:text-lg">Fiabilité Garantie</h3>
                        <p class="text-xs md:text-sm text-slate-700 leading-relaxed">Une expertise technique reconnue au service de votre sérénité.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 4 : EXPERTISE / SERVICES -->
        <section id="expertise" class="
            bg-center bg-cover bg-no-repeat relative scroll-mt-20
            w-full bg-white block py-24 px-0 md:px-4
        " style={`background-image: url('${background_section3.src}');`}
        >
            <div class="absolute inset-0 bg-white/65 backdrop-blur-sm z-0 shadow-[inset_0_0_100px_rgba(255,255,255,0.5)]"></div>
            <Expertise client:load />
        </section>

        <!-- Séparation : transition vers la section sombre -->
        <div class="h-24 md:h-32 bg-gradient-to-b from-white to-[#004732]"></div>

        <!-- SECTION 4 : LA DIFFÉRENCE -->
        <section id="why" class="
            w-full bg-[#004732] text-white block py-24 px-4 scroll-mt-20
        ">
            <div class="max-w-5xl mx-auto w-full">
                <!-- En-tête centré -->
                <div class="text-center mb-12 md:mb-16">
                    <span class="text-[#FFBD59] font-bold tracking-widest uppercase text-xs md:text-sm mb-3 block">Notre différence</span>
                    <h2 data-reveal class="text-2xl md:text-5xl font-bold mb-4 md:mb-6 leading-tight">Une relation de confiance qui s’inscrit<br class="hidden md:block"/>dans la durée</h2>

                    <p data-reveal class="text-white/70 font-light text-base md:text-lg max-w-3xl mx-auto leading-relaxed">
                        Dans un environnement réglementaire exigeant, la technologie seule ne suffit pas. C’est l’expertise et la disponibilité de notre équipe qui font la différence, au quotidien.
                    </p>
                </div>

                <!-- Grille de 4 cartes -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
                    <!-- Carte 1 -->
                    <div data-reveal class="bg-white/5 border border-white/10 backdrop-blur-md rounded-2xl p-6 hover:-translate-y-2 hover:bg-white/10 transition-all duration-300">
                        <div class="w-12 h-12 rounded-xl bg-[#FFBD59]/15 flex items-center justify-center mb-5">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#FFBD59]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path stroke-linecap="round" stroke-linejoin="round" d="M22 21v-2a4 4 0 0 0-3-3.87"/><path stroke-linecap="round" stroke-linejoin="round" d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                        </div>
                        <h3 class="font-bold text-lg md:text-xl text-white mb-2">Un interlocuteur dédié</h3>
                        <p class="text-white/70 text-sm md:text-base leading-relaxed">Un expert unique suit votre dossier dans la durée et connaît les spécificités de votre entreprise.</p>
                    </div>

                    <!-- Carte 2 -->
                    <div data-reveal class="bg-white/5 border border-white/10 backdrop-blur-md rounded-2xl p-6 hover:-translate-y-2 hover:bg-white/10 transition-all duration-300">
                        <div class="w-12 h-12 rounded-xl bg-[#FFBD59]/15 flex items-center justify-center mb-5">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#FFBD59]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4"/>
                            </svg>
                        </div>
                        <h3 class="font-bold text-lg md:text-xl text-white mb-2">Silae, associé à une vérification humaine</h3>
                        <p class="text-white/70 text-sm md:text-base leading-relaxed">La technologie ne remplace pas l’humain. Silae assure la fiabilité technique de vos paies, tandis que notre équipe apporte le contrôle et l’expertise indispensables. Chaque bulletin est vérifié par un expert avant d’être transmis.</p>
                    </div>

                    <!-- Carte 3 -->
                    <div data-reveal class="bg-white/5 border border-white/10 backdrop-blur-md rounded-2xl p-6 hover:-translate-y-2 hover:bg-white/10 transition-all duration-300">
                        <div class="w-12 h-12 rounded-xl bg-[#FFBD59]/15 flex items-center justify-center mb-5">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#FFBD59]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5"/><circle cx="12" cy="12" r="9"/>
                            </svg>
                        </div>
                        <h3 class="font-bold text-lg md:text-xl text-white mb-2">Des délais de réponse clairs</h3>
                        <p class="text-white/70 text-sm md:text-base leading-relaxed">Vos demandes sont traitées sous 24h ouvrées, un engagement que nous tenons de manière constante.</p>
                    </div>

                    <!-- Carte 4 -->
                    <div data-reveal class="bg-white/5 border border-white/10 backdrop-blur-md rounded-2xl p-6 hover:-translate-y-2 hover:bg-white/10 transition-all duration-300">
                        <div class="w-12 h-12 rounded-xl bg-[#FFBD59]/15 flex items-center justify-center mb-5">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#FFBD59]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M2 12h20"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                            </svg>
                        </div>
                        <h3 class="font-bold text-lg md:text-xl text-white mb-2">Une expertise multi-conventions et internationale</h3>
                        <p class="text-white/70 text-sm md:text-base leading-relaxed">Nous accompagnons aussi les entreprises dont la paie dépasse un seul cadre réglementaire.</p>
                    </div>
                </div>

                <!-- Conclusion -->
                <p class="text-center text-white/90 text-base md:text-lg font-medium mt-12 md:mt-16 max-w-3xl mx-auto">
                    Notre différence, c’est un accompagnement régulier et durable, qui se traduit par des actions concrètes, plutôt qu’une simple promesse ponctuelle.
                </p>
            </div>
        </section>

        <!-- Séparation : transition vers la section internationale -->
        <div class="h-24 md:h-32 bg-gradient-to-b from-[#004732] to-[#f8faf9]"></div>

        <!-- SECTION 6 : IMPLANTATION INTERNATIONALE -->
        <section id="international" class="w-full bg-[#f8faf9] block py-24 px-4 scroll-mt-20">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-10 md:mb-16">
                    <span class="text-[#FFBD59] font-bold tracking-widest uppercase text-xs md:text-sm mb-3 block">Implantation Internationale</span>
                    <h2 data-reveal class="text-2xl md:text-5xl font-bold mb-4 md:mb-6 text-[#004732] leading-tight">Une expertise au-delà de nos frontières</h2>
                    <p data-reveal class="text-base md:text-lg text-slate-700 leading-relaxed font-medium max-w-3xl mx-auto">
                        Une paie qui s’adapte à la diversité de votre entreprise. Nous maîtrisons plusieurs conventions collectives et accompagnons également les entreprises ayant des enjeux de paie à l’international.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
                    <!-- Carte / Image Réelle -->
                    <!-- Carte / Image Réelle -->
                    <div data-reveal class="order-2 md:order-1">
                        <!-- Conteneur vertical (aspect-[3/4]) pour épouser le format de ta carte -->
                        <div class="aspect-[3/4] rounded-3xl bg-gradient-to-br from-[#004732] to-[#00a86b] p-1 shadow-xl">
                            <div class="w-full h-full rounded-[20px] bg-[#eef2f5] relative overflow-hidden flex items-center justify-center">

                                <!-- Ton image avec object-contain pour qu'elle s'affiche en entier -->
                                <img
                                        src={carte_SoRH.src}
                                        alt="Carte des implantations SO-RH EXPERT en France et en Afrique"
                                        class="w-full h-full object-contain p-4 md:p-6 drop-shadow-md"
                                />

                            </div>
                        </div>
                    </div>
                    <!-- Texte et points forts -->
                    <div class="order-1 md:order-2 space-y-6">
                        <div data-reveal class="flex items-start gap-4 p-5 bg-white rounded-2xl shadow-md border border-slate-100">
                            <div class="w-12 h-12 rounded-full bg-[#00a86b] text-white flex items-center justify-center flex-shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5m14.945 0H22M12 2v2.055M12 19.945V22M5.636 5.636l1.455 1.455m9.818 9.818l1.455 1.455M5.636 18.364l1.455-1.455m9.818-9.818l1.455-1.455M12 8a4 4 0 100 8 4 4 0 000-8z"/>
                                </svg>
                            </div>
                            <div>
                                <h3 class="font-bold text-[#004732] mb-1 text-base md:text-lg">Afrique de l'Ouest</h3>
                                <p class="text-xs md:text-sm text-slate-700 leading-relaxed">Une présence régionale forte pour accompagner les entreprises dans leurs développements ouest-africains.</p>
                            </div>
                        </div>

                        <div data-reveal class="flex items-start gap-4 p-5 bg-white rounded-2xl shadow-md border border-slate-100">
                            <div class="w-12 h-12 rounded-full bg-[#FFBD59] text-white flex items-center justify-center flex-shrink-0">
